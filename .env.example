APP_NAME=COCO-AID
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000
OFFLINE_MODE=false
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Optional: configure CoCO-PILOT here or through the local Settings panel.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Phase 1 architecture and diagnostics
PRODUCT_NAME=COCOAID
CONTRACT_API_VERSION=3.0.0-draft.6
ENABLE_V2_CONTRACT_API=true
ENABLE_LEGACY_API=true
ENABLE_REQUEST_METRICS=true
STRICT_MODEL_RUNTIME_COMPATIBILITY=false
LOG_LEVEL=INFO
LOG_FORMAT=text

# Weather-provider resilience (Phase 6.1 hotfix)
WEATHER_CONNECT_TIMEOUT_SECONDS=20
WEATHER_READ_TIMEOUT_SECONDS=60
WEATHER_REQUEST_ATTEMPTS=2
WEATHER_DIRECT_CONNECTION_FALLBACK=true
WEATHER_USE_SYSTEM_TRUST_STORE=true

# Production/deployment runtime (Render persistent disk recommended)
# PERSISTENT_DATA_DIR=/var/data/cocoaid
AUTO_PHASE_WORKFLOWS=false
AUTO_PHASE_POLL_SECONDS=90
ALLOW_RUNTIME_API_KEY_CONFIGURATION=true
AUTO_SEED_REFERENCE_DATA=true
