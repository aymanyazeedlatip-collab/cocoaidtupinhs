{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/build_vercel_frontend.mjs",
  "outputDirectory": "vercel_dist",
  "cleanUrls": false,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://cocoaid-backend-free.onrender.com/api/:path*"
    },
    {
      "source": "/weather-viewer",
      "destination": "/static/weather-viewer/index.html"
    }
  ],
  "headers": [
    {
      "source": "/static/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
